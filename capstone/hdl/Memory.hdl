
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Separate RAM and Screen write signals
  DMux(
    in=load,
    sel=address[14],
    a=loadRam,
    b=loadScreen
);

Not(in=address[13], out=notAddress13);

And(
    a=loadScreen,
    b=notAddress13,
    out=screenLoad
);

    // RAM16K
    RAM16K(
        in=in,
        load=loadRam,
        address=address[0..13],
        out=ramOut
    );

    // Screen memory
   Screen(
    in=in,
    load=screenLoad,
    address=address[0..12],
    out=screenOut
);

    // Keyboard input
    Keyboard(out=keyboardOut);

    // Select the correct memory output
    Mux4Way16(
        a=ramOut,
        b=ramOut,
        c=screenOut,
        d=keyboardOut,
        sel=address[13..14],
        out=out
    );
}
